{
  "id": "hollows-rpg",
  "title": "Hollows RPG",
  "description": "The Hollows RPG system for FoundryVTT!",
  "authors": [
    {
      "name": "Dragodoth",
      "discord": "dragodoth"
    }
  ],
  "documentTypes": {
    "Actor": {
      "hunter": {
        "htmlFields": ["biography.value", "biography.director"],
        "gmOnlyFields": ["biography.director"]
      },
      "entity": {
        "htmlFields": ["biography.value", "biography.director"],
        "gmOnlyFields": ["biography.director"]
      }
    },
    "Item": {
      "weapon": {
        "filePathFields": {}
      },
      "form": {
        "filePathFields": {}
      }
    },
    "ChatMessage": {
      "standard": {}
    }
  },
  "flags": {
    "hotReload": {
      "extensions": ["css", "html", "hbs", "json"],
      "paths": ["css", "src/styles", "lang", "templates"]
    }
  },
  "url": "https://github.com/Dragodoth/hollows-rpg",
  "license": "LICENSE.md",
  "readme": "README.md",
  "bugs": "https://github.com/Dragodoth/hollows-rpg/issues",
  "changelog": "CHANGELOG.md",
  "media": [
    {
      "type": "setup",
      "url": "systems/hollows-rpg/assets/anvil-impact.png",
      "thumbnail": "systems/hollows-rpg/assets/anvil-impact.png"
    }
  ],
  "version": "0.0.5",
  "compatibility": {
    "minimum": 13,
    "verified": "13.351"
  },
  "esmodules": ["hollows-rpg.mjs"],
  "styles": [
    { "src": "css/hollows-rpg-system.css", "layer": "system" },
    { "src": "css/hollows-rpg-variables.css", "layer": "variables" },
    { "src": "css/hollows-rpg-elements.css", "layer": "elements" }
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "packs": [],
  "packFolders": [],
  "socket": false,
  "manifest": "https://raw.githubusercontent.com/Dragodoth/hollows-rpg/refs/heads/main/system.json",
  "download": "https://github.com/Dragodoth/hollows-rpg/releases/download/release-0.0.5/hollows-rpg-release-0.0.5.zip",
  "background": "systems/hollows-rpg/assets/anvil-impact.png",
  "grid": {
    "type": 1,
    "distance": 1,
    "units": "sq",
    "diagonals": 0
  },
  "primaryTokenAttribute": "health.resolve",
  "secondaryTokenAttribute": "health.wounds",
  "initiative": "1d20"
