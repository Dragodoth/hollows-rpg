<fieldset class="flexcol">
   <legend>{{localize "HOLLOWS_RPG.SHEET.Bonuses"}}</legend>
  {{formGroup systemFields.bonuses.fields.stats.fields.modifiedStats value=system.bonuses.stats.modifiedStats options=stats disabled=isPlay}}
  {{#if modifiedStatsSize}}
    <fieldset>
      <legend>{{localize "HOLLOWS_RPG.Item.StatBonuses.label"}}</legend>
      {{#each statBonuses as |stat|}}
        {{formGroup stat.field.bonus value=stat.bonus disabled=@root.isPlay}}
      {{/each}}
    </fieldset>
  {{/if}}
  {{formGroup systemFields.bonuses.fields.health.fields.resolve value=system.bonuses.health.resolve disabled=isPlay}}
  {{formGroup systemFields.bonuses.fields.health.fields.wounds value=system.bonuses.health.wounds disabled=isPlay}}
</fieldset>
<fieldset class="flexcol">
   <legend>{{localize "HOLLOWS_RPG.SHEET.Resource"}}</legend>
  {{formGroup systemFields.resource.fields.hasResource value=system.resource.hasResource disabled=isPlay}}
  {{#if system.resource.hasResource}}
    {{formGroup systemFields.resource.fields.name value=system.resource.name disabled=isPlay}}
    {{formGroup systemFields.resource.fields.type value=system.resource.type options=resourceType disabled=isPlay}}
    {{#if ( eq system.resource.type "token")}}
      {{formGroup systemFields.resource.fields.state value=system.resource.state disabled=isPlay}}
      {{#if form.system.resource.modifiesResource}}
        {{formGroup systemFields.resource.fields.tossable value=form.system.resource.tossable disabled=true}}
        <span class="hint">{{localize "HOLLOWS_RPG.SHEET.modifiedByForm" weapon=document.name form=form.name}}</span>
      {{else}}
        {{formGroup systemFields.resource.fields.tossable value=system.resource.tossable disabled=isPlay}}
      {{/if}}

    {{/if}}
    {{#if ( eq system.resource.type "counter")}}
      {{formGroup systemFields.resource.fields.value value=system.resource.value disabled=isPlay}}
      {{#if form.system.resource.modifiesResource}}
        {{formGroup systemFields.resource.fields.max value=form.system.resource.max disabled=true}}
        <span class="hint">{{localize "HOLLOWS_RPG.SHEET.modifiedByForm" weapon=document.name form=form.name}}</span>
      {{else}}
        {{formGroup systemFields.resource.fields.max value=system.resource.max disabled=isPlay}}
      {{/if}}
    {{/if}}
  {{/if}}
</fieldset>
