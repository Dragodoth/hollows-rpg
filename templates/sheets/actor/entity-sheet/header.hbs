{{! Sheet Header }}
<header class="sheet-header">
  <img class="profile-img" src="{{document.img}}" alt="{{document.name}}" data-action="{{ifThen isPlay "
    showPortraitArtwork" "editImage" }}" data-edit="img" title="{{document.name}}">
  <div class="header-center flexcol">
    <div class="document-name">
      {{#if isPlay}}
      <h2>{{document.name}}</h2>
      {{else}}
      {{formInput fields.name value=source.name placeholder=(localize "Name")}}
      {{/if}}
    </div>
    {{#if isPlay}}
    <fieldset class="resources flexrow">
      <legend>{{localize "HOLLOWS_RPG.SHEET.Health"}}</legend>
      <div class="resource resolve flexcol">
        <div class="resource-label">
          <span>{{systemFields.health.fields.resolve.label}}</span>
        </div>
        <div class="form-group resource-content flexrow">
          <div class="resource-temporary">
            {{formGroup
            systemFields.health.fields.resolve.fields.temporary
            value=system.health.resolve.temporary
            dataset=datasets.notSource
            classes="stacked"
            }}
          </div>
          <div class="resource-current">
            {{formGroup
            systemFields.health.fields.resolve.fields.value
            value=system.health.resolve.value
            dataset=datasets.notSource
            classes="stacked"
            }}
          </div>
          <span class="resource-max">
            <div class=" stacked">
              <label class="input-placeholder-label">
                {{localize "HOLLOWS_RPG.Actor.base.FIELDS.health.resolve.max.label"}}
              </label>
              <div class="input-placeholder">
                {{system.health.resolve.max}}
              </div>
            </div>
          </span>
        </div>
      </div>
      <div class="resource wounds flexcol">
        <div class="resource-label">
          <span>{{systemFields.health.fields.wounds.label}}</span>
        </div>
        <div class="form-group resource-content flexrow">
          <div class="resource-temporary">
            {{formGroup
            systemFields.health.fields.wounds.fields.temporary
            value=system.health.wounds.temporary
            dataset=datasets.notSource
            classes="stacked"
            }}
          </div>
          <div class="resource-current">
            {{formGroup
            systemFields.health.fields.wounds.fields.value
            value=system.health.wounds.value
            dataset=datasets.notSource
            classes="stacked"
            }}
          </div>
          <span class="resource-max">
            <div class=" stacked">
              <label class="input-placeholder-label">
                {{localize "HOLLOWS_RPG.Actor.base.FIELDS.health.wounds.max.label"}}
              </label>
              <div class="input-placeholder">
                {{system.health.wounds.max}}
              </div>
            </div>
          </span>
        </div>
      </div>
    </fieldset>
    {{/if}}
    <fieldset class="stats flexrow">
      <legend>
        {{systemFields.entity.fields.defences.label}}
        {{#unless (or isPlay editDefences)}}
        <button type="button" class="icon fa-solid fa-cog" data-action="editDefences"></button>
        {{/unless}}
      </legend>
      {{#each defences as |defence key|}}
      {{#unless ../editDefences}}
      <a class="stats play {{disabled (not @root.owner)}}" {{disabled (not @root.isPlay)}}>
        {{defence.field.label}} {{numberFormat defence.value}}
      </a>
      {{else}}
      <label class="stats edit" data-tooltip="{{defence.field.label}}">
        <span class="label">{{defence.field.hint}}</span>
        {{formInput defence.field value=defence.value placeholder="10"}}
      </label>
      {{/unless}}
      {{/each}}
    </fieldset>
  </div>
</header>